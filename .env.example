# Model provider configuration; no credentials are committed.
LLM_PROVIDER=not_configured
LLM_MODEL=not_configured
LLM_FALLBACK_MODEL=not_configured
LLM_TEMPERATURE=0

# Persistence / retrieval
DATABASE_URL=sqlite:///data/control-plane.db
REDIS_URL=redis://localhost:6379/0
VECTOR_DB_URL=local://documents
GRAPH_DB_URL=memory://local

# SCM / CI providers
GITHUB_TOKEN=secret://github/token
GITLAB_TOKEN=secret://gitlab/token
BITBUCKET_TOKEN=secret://bitbucket/token

# Cloud / infrastructure
AWS_REGION=ap-south-1
AWS_PROFILE=default
AZURE_SUBSCRIPTION_ID=
GCP_PROJECT=
KUBECONFIG=~/.kube/config

# Communications
SLACK_WEBHOOK=secret://slack/webhook
TEAMS_WEBHOOK=secret://teams/webhook

# Safety limits
MAX_AGENT_RUNTIME_SECONDS=3600
MAX_TOOL_CALLS=100
MAX_RETRIES=2
MAX_MODEL_COST_USD=1.00
MAX_PIPELINE_RUNTIME_SECONDS=7200
MAX_DEPLOYMENT_BLAST_RADIUS=development
